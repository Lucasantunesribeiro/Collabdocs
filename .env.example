# Copie para .env e preencha. Nunca commite o .env.

# ── Autenticação (NextAuth) ───────────────────────────────────────────────────
# Mesmo segredo HS256 usado por Next.js, API .NET (Jwt__Secret) e Worker.
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET=troque-por-um-segredo-aleatorio
NEXTAUTH_URL=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Frontend ──────────────────────────────────────────────────────────────────
# API .NET usada SOMENTE no servidor pelo proxy /api/dotnet/[...path].
DOTNET_API_URL=http://localhost:5000/api
# Worker (WebSocket/presença). NEXT_PUBLIC_* são embutidas no build.
NEXT_PUBLIC_API_URL=http://localhost:8787/api
NEXT_PUBLIC_WS_URL=ws://localhost:8787

# ── Worker (Cloudflare) ───────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000
# URL base da API .NET consultada para autorizar o WebSocket (GET /documents/{id}).
# Sem ela o Worker usa o próprio D1, que não contém os documentos criados via .NET.
DOCUMENTS_API_URL=http://localhost:5000/api

# ── API .NET em produção (Render) ─────────────────────────────────────────────
# Aceita formato Npgsql ou URI (Neon/Supabase): postgresql://user:senha@host/db?sslmode=require
# ConnectionStrings__Default=postgresql://usuario:senha@ep-exemplo.neon.tech/neondb?sslmode=require
# Jwt__Secret=<mesmo valor de NEXTAUTH_SECRET>

# ── docker compose (infra local) ──────────────────────────────────────────────
POSTGRES_USER=collabdocs
POSTGRES_PASSWORD=troque-esta-senha
RABBITMQ_USER=collabdocs
RABBITMQ_PASSWORD=troque-esta-senha
